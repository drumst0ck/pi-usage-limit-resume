{
  "name": "pi-usage-limit-resume",
  "version": "0.3.0",
  "description": "Pi extension: saves when each provider's usage window resets (5h, weekly, monthly) and continues your task when an exhausted limit resets.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "usage-limit",
    "rate-limit",
    "reset",
    "quota"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "extensions/",
    "!extensions/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test extensions/usage-limit-resume/*.test.ts extensions/usage-limit-resume/providers/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.2.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drumst0ck/pi-usage-limit-resume.git"
  },
  "homepage": "https://github.com/drumst0ck/pi-usage-limit-resume#readme",
  "bugs": {
    "url": "https://github.com/drumst0ck/pi-usage-limit-resume/issues"
  }
}
